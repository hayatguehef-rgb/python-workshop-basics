      "source": [
        "def filter_even_numbers(numbers):\n",
        "\n",
        "    result = []\n",
        "    for num in numbers:\n",
        "        if num % 2 == 0:\n",
        "            result.append(num)\n",
        "    return result\n",
        "\n",
        "test = [1, 2, 3, 4, 5, 6, 7, 8]\n",
        "print(filter_even_numbers(test))\n"
      ]
    }
  ]
